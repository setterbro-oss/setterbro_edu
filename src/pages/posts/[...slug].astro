---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(entry => ({
    params: { slug: entry.slug },
    props: { entry, allPosts: posts },
  }));
}

const { entry, allPosts } = Astro.props;
const { Content } = await entry.render();

// 현재 글을 제외한 연관 추천글 4개
const relatedPosts = allPosts
  .filter(p => p.slug !== entry.slug)
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, 4);

const categoryNames: Record<string, string> = {
  cert: '국가자격증',
  hrd: '내일배움카드',
  exam: '채용고시',
};

// 공식기관 누리집 링크 (Frontmatter에 link가 없으면 기본값 설정)
const officialLink = entry.data.link || 'https://www.hrd.go.kr';
const sourceName = entry.data.sourceName || '직업훈련포털 HRD-Net / 관련 공식 기관';
---

<Layout title={entry.data.title} description={entry.data.description}>
  <article class="post-container">
    <!-- Breadcrumb Nav -->
    <nav class="breadcrumb">
      <a href="/">홈</a> &gt; <a href={`/category/${entry.data.category}`}>{categoryNames[entry.data.category] || '일반'}</a>
    </nav>

    <!-- 카테고리 태그 및 날짜 -->
    <div class="post-header-meta">
      <span class="category-badge">{categoryNames[entry.data.category] || '일반'}</span>
      <time class="post-date">{new Date(entry.data.pubDate).toLocaleDateString('ko-KR')}</time>
    </div>

    <!-- 메인 제목 -->
    <h1 class="post-title">{entry.data.title}</h1>

    <!-- 출처 및 안내 메타박스 -->
    <div class="meta-box">
      <span>🗓️ 게시일: {new Date(entry.data.pubDate).toLocaleDateString('ko-KR')}</span>
      <span>🏛️ 확인 출처: {sourceName}</span>
      <span>ℹ️ 제도·일정·금액은 변경될 수 있으니 공식 출처에서 최종 확인하세요.</span>
    </div>

    <!-- 1. 핵심 요약 & 공유 기능 박스 -->
    <div class="summary-card">
      <div class="summary-header">
        <strong>📌 핵심 요약 & 공유</strong>
        <div class="share-buttons">
          <button type="button" class="btn-share" onclick="copyCurrentUrl()">🔗 링크 복사</button>
        </div>
      </div>
      <p>본 포스팅은 정부 및 지자체 공식 가이드라인을 기반으로 핵심 정보와 신청 방법, 자격 요건을 정돈하여 제공합니다.</p>
    </div>

    <!-- 본문 내용 -->
    <div class="post-body">
      <Content />
    </div>

    <!-- 2. 인라인 모의 계산기 위젯 (체류시간 증대용) -->
    <div class="calculator-widget">
      <div class="calc-title">📈 모의 수혜금/지원금 간단 계산기</div>
      <p class="calc-desc">예상 기준 금액과 환급/지원 비율(%)을 입력하여 대략적인 혜택을 산출해보세요.</p>
      <div class="calc-form">
        <div class="input-group">
          <label for="calc-amount">기준 금액(원)</label>
          <input type="number" id="calc-amount" placeholder="예: 3000000" step="100000" />
        </div>
        <div class="input-group">
          <label for="calc-rate">지원/비율(%)</label>
          <input type="number" id="calc-rate" placeholder="예: 80" step="5" />
        </div>
      </div>
      <button type="button" class="calc-btn" onclick="calculateBenefit()">즉시 계산하기</button>
      <div id="calc-result" class="calc-result">결과가 여기에 표시됩니다.</div>
    </div>

    <!-- 3. 관련 공식 기관 안내 & 바로가기 버튼 -->
    <div class="official-link-box">
      <div class="official-info">
        🏛️ <strong>관련 공식 기관 누리집 안내</strong>
        <p>상세 모집 요강 및 원서 접수는 주관 기관 공식 누리집에서 직접 확인하세요.</p>
      </div>
      <a href={officialLink} target="_blank" rel="noopener noreferrer" class="btn-official-go">
        👉 공식 누리집 바로가기
      </a>
    </div>

    <!-- 4. 하단 관련 추천 포스팅 (카드형 Grid) -->
    <section class="related-posts-section">
      <h3>💡 함께 보면 좋은 추천 글</h3>
      <div class="related-grid">
        {relatedPosts.map(post => (
          <a href={`/posts/${post.slug}/`} class="related-card">
            <div class="related-card-content">
              <span class="related-badge">{categoryNames[post.data.category] || '안내'}</span>
              <h4>{post.data.title}</h4>
              <time>{new Date(post.data.pubDate).toLocaleDateString('ko-KR')}</time>
            </div>
          </a>
        ))}
      </div>
    </section>
  </article>
</Layout>

<script is:inline>
  // 1. URL 복사 기능
  function copyCurrentUrl() {
    navigator.clipboard.writeText(window.location.href).then(() => {
      alert('포스팅 주소가 복사되었습니다.');
    }).catch(() => {
      alert('주소 복사에 실패했습니다.');
    });
  }

  // 2. 간단 수혜금 계산기
  function calculateBenefit() {
    const amount = parseFloat(document.getElementById('calc-amount').value);
    const rate = parseFloat(document.getElementById('calc-rate').value);
    const resultEl = document.getElementById('calc-result');

    if (isNaN(amount) || isNaN(rate)) {
      resultEl.innerHTML = '<span style="color:#ef4444;">금액과 비율을 바르게 입력해 주세요.</span>';
      return;
    }

    const calculated = Math.round(amount * (rate / 100));
    resultEl.innerHTML = `예상 산출 금액: <strong>${calculated.toLocaleString()}원</strong>`;
  }
</script>

<style is:global>
  /* 기본 레이아웃 & 본문 가독성 */
  .post-container {
    background-color: #ffffff;
    border: 1px solid #f1f5f9;
    border-radius: 12px;
    padding: 32px 28px;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.02);
  }

  .breadcrumb {
    font-size: 13px;
    color: #94a3b8;
    margin-bottom: 12px;
  }
  .breadcrumb a {
    color: #64748b;
    text-decoration: none;
  }

  .post-header-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .category-badge {
    background-color: #059669;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
  }
  .post-date {
    font-size: 13px;
    color: #94a3b8;
  }

  .post-title {
    font-size: 26px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.4;
    margin-bottom: 18px;
    letter-spacing: -0.02em;
  }

  .meta-box {
    background-color: #f8fafc;
    border: 1px solid #f1f5f9;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 13px;
    color: #64748b;
    margin-bottom: 20px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* 1. 요약 및 공유 카드 */
  .summary-card {
    background-color: #f0fdf4;
    border: 1px solid #bbf7d0;
    padding: 18px 20px;
    border-radius: 10px;
    margin-bottom: 28px;
  }
  .summary-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .summary-header strong {
    color: #166534;
    font-size: 15px;
  }
  .btn-share {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    padding: 5px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    color: #334155;
    cursor: pointer;
  }
  .btn-share:hover {
    background: #f8fafc;
  }
  .summary-card p {
    font-size: 14px;
    color: #15803d;
    line-height: 1.6;
    margin: 0;
  }

  /* 본문 상세 타이포그래피 */
  .post-body {
    font-size: 15.5px;
    color: #334155;
    line-height: 1.8;
    letter-spacing: -0.01em;
  }
  .post-body p { margin-bottom: 20px; }
  .post-body h2 {
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    margin-top: 36px;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 2px solid #e2e8f0;
    line-height: 1.4;
  }
  .post-body h3 {
    font-size: 17px;
    font-weight: 700;
    color: #1e293b;
    margin-top: 24px;
    margin-bottom: 12px;
  }
  .post-body ul, .post-body ol { margin-bottom: 20px; padding-left: 20px; }
  .post-body li { margin-bottom: 8px; }
  .post-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 14px;
  }
  .post-body th, .post-body td {
    border: 1px solid #e2e8f0;
    padding: 10px 12px;
    text-align: left;
  }
  .post-body th { background-color: #f8fafc; font-weight: 700; color: #0f172a; }

  /* 2. 계산기 위젯 스타일 */
  .calculator-widget {
    background: #faf5ff;
    border: 1px solid #e9d5ff;
    padding: 20px;
    border-radius: 12px;
    margin: 32px 0;
  }
  .calc-title {
    font-size: 16px;
    font-weight: 800;
    color: #6b21a8;
    margin-bottom: 6px;
  }
  .calc-desc {
    font-size: 13px;
    color: #7e22ce;
    margin-bottom: 14px;
  }
  .calc-form {
    display: flex;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .input-group {
    flex: 1;
    min-width: 140px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .input-group label {
    font-size: 12px;
    font-weight: 700;
    color: #4c1d95;
  }
  .input-group input {
    padding: 8px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 14px;
    outline: none;
  }
  .calc-btn {
    width: 100%;
    background: #059669;
    color: #ffffff;
    padding: 10px;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }
  .calc-btn:hover { background: #047857; }
  .calc-result {
    margin-top: 12px;
    padding: 10px;
    background: #ffffff;
    border-radius: 6px;
    border: 1px dashed #c084fc;
    font-size: 14px;
    text-align: center;
    color: #334155;
  }

  /* 3. 공식 기관 바로가기 박스 */
  .official-link-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 18px;
    border-radius: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin: 32px 0;
    flex-wrap: wrap;
  }
  .official-info strong {
    font-size: 14px;
    color: #0f172a;
  }
  .official-info p {
    font-size: 12px;
    color: #64748b;
    margin-top: 4px;
  }
  .btn-official-go {
    background: #1e293b;
    color: #ffffff;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .btn-official-go:hover {
    background: #0f172a;
  }

  /* 4. 하단 관련 추천 포스팅 Grid */
  .related-posts-section {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid #f1f5f9;
  }
  .related-posts-section h3 {
    font-size: 16px;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 16px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  .related-card {
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    border-radius: 8px;
    padding: 14px;
    text-decoration: none;
    transition: transform 0.1s ease;
  }
  .related-card:hover {
    transform: translateY(-2px);
    border-color: #cbd5e1;
  }
  .related-badge {
    font-size: 11px;
    font-weight: 700;
    color: #7e22ce;
    display: inline-block;
    margin-bottom: 6px;
  }
  .related-card h4 {
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.4;
    margin-bottom: 8px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-card time {
    font-size: 11px;
    color: #94a3b8;
  }

  @media (max-width: 640px) {
    .post-container { padding: 20px 16px; }
    .post-title { font-size: 21px; }
    .post-body { font-size: 14.5px; }
    .official-link-box { flex-direction: column; align-items: flex-start; }
    .btn-official-go { width: 100%; text-align: center; }
  }
</style>
