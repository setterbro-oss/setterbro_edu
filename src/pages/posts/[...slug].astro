---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(entry => ({
    params: { slug: entry.slug },
    props: { entry, allPosts: posts },
  }));
}

const { entry, allPosts } = Astro.props;
const { Content } = await entry.render();

// 현재 글을 제외한 연관 추천글 4개 추출
const relatedPosts = allPosts
  .filter(p => p.slug !== entry.slug)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 4);

const categoryNames: Record<string, string> = {
  cert: '국가자격증',
  hrd: '내일배움카드',
  exam: '채용고시',
};
---

<Layout title={entry.data.title} description={entry.data.description}>
  <article style="background-color: #ffffff; border: 1px solid #f1f5f9; border-radius: 12px; padding: 24px; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.02);">
    <!-- 상단 태그 및 타이틀 -->
    <header style="margin-bottom: 20px;">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
        <span style="background-color: #059669; color: #ffffff; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px;">
          {categoryNames[entry.data.category] || '일반'}
        </span>
        <time style="font-size: 11px; color: #94a3b8;">
          {new Date(entry.data.pubDate).toLocaleDateString('ko-KR')}
        </time>
      </div>
      
      <h1 style="font-size: 20px; font-weight: 800; color: #0f172a; line-height: 1.35; margin-bottom: 12px;">
        {entry.data.title}
      </h1>

      <div style="background-color: #f8fafc; border: 1px solid #f1f5f9; padding: 10px 12px; border-radius: 6px; font-size: 11px; color: #64748b; margin-bottom: 12px; display: flex; gap: 12px; flex-wrap: wrap;">
        <span>📅 게시일: {new Date(entry.data.pubDate).toLocaleDateString('ko-KR')}</span>
        <span>ℹ️ 제도·일정·금액은 변경될 수 있으니 공식 출처에서 최종 확인하세요.</span>
      </div>
    </header>

    <!-- 본문 내용 -->
    <div style="font-size: 13px; color: #334155; line-height: 1.7; margin-bottom: 24px;">
      <Content />
    </div>

    <!-- 하단 연관 추천글 목록 (4개 출력) -->
    <section style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #f1f5f9;">
      <h3 style="font-size: 13px; font-weight: 800; color: #0f172a; margin-bottom: 10px;">함께 보면 좋은 글</h3>
      <div style="display: flex; flex-direction: column; gap: 8px;">
        {relatedPosts.map(post => (
          <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px;">
            <a href={`/posts/${post.slug}/`} style="font-size: 12px; font-weight: 700; color: #7e22ce; line-height: 1.4; flex: 1;">
              • {post.data.title}
            </a>
            <span style="font-size: 10px; color: #94a3b8; white-space: nowrap;">
              {new Date(post.data.pubDate).toLocaleDateString('ko-KR')}
            </span>
          </div>
        ))}
      </div>
    </section>
  </article>
</Layout>
