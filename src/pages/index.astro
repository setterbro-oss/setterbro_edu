---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE_NAME } from '../config';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryNames: Record<string, { name: string; color: string }> = {
  cert: { name: '국가자격증', color: '#1d4ed8' },
  hrd: { name: '내일배움카드', color: '#059669' },
  exam: { name: '채용고시', color: '#d97706' },
};
---

<Layout title={SITE_NAME}>
  <div class="home-wrap">
    <!-- 메인 상단 배너 -->
    <section class="hero">
      <h1>🎓 샛터형의 자격증·국비교육 트렌드센터</h1>
      <p>국가기술자격증 일정부터 내일배움카드 국비지원, 공무원·공기업 채용까지 공식 출처 링크와 함께 정리합니다.</p>
    </section>

    <!-- 최신 포스팅 목록 -->
    <section class="posts-section">
      <h2>📰 최신 정보 포스팅</h2>
      <div id="post-list">
        {posts.map((post) => {
          const cat = categoryNames[post.data.category] || { name: '일반', color: '#64748b' };
          return (
            <article class="post-card">
              <div class="post-meta">
                <span class="category" style={`background:${cat.color}`}>{cat.name}</span>
                <time>{post.data.pubDate.toLocaleDateString('ko-KR')}</time>
              </div>
              <h3><a href={`/posts/${post.slug}/`}>{post.data.title}</a></h3>
              <p class="description">{post.data.description}</p>
              <a class="read-more" href={`/posts/${post.slug}/`}>상세 내용 확인하기 →</a>
            </article>
          );
        })}
      </div>
    </section>
  </div>

  <style>
    .home-wrap { width: 100%; margin: 0 auto; }
    .hero { text-align:center; margin: 0 0 24px; padding: 20px; background:#fff; border:1px solid #f1f5f9; border-radius:12px; box-shadow:0 1px 2px rgba(0,0,0,.02); }
    .hero h1 { font-size:16px; line-height:1.45; font-weight:800; color:#0f172a; margin-bottom:4px; }
    .hero p { color:#64748b; font-size:11px; line-height:1.65; }
    
    .posts-section { margin-top:0; }
    .posts-section h2 { font-size:13px; font-weight:800; color:#0f172a; margin-bottom:16px; }
    
    .post-card { background:#fff; padding:20px; border-radius:12px; border:1px solid #f1f5f9; margin-bottom:16px; box-shadow:0 1px 2px rgba(0,0,0,.02); }
    .post-meta { display:flex; gap:8px; align-items:center; margin-bottom:6px; }
    .category { color:#fff; font-size:10px; font-weight:700; padding:2px 6px; border-radius:4px; }
    .post-meta time { color:#94a3b8; font-size:11px; }
    .post-card h3 { margin-bottom:6px; font-size:15px; line-height:1.35; }
    .post-card h3 a { text-decoration:none; color:#0f172a; font-weight:800; }
    .post-card h3 a:hover { color:#7e22ce; }
    .description { color:#64748b; font-size:12px; line-height:1.5; margin-bottom:8px; }
    .read-more { color:#7e22ce; text-decoration:none; font-weight:700; font-size:11px; }
    
    @media(max-width:640px) {
      .hero { padding:16px; margin-bottom:16px; }
      .hero h1 { font-size:14px; }
      .post-card { padding:16px; }
    }
  </style>
</Layout>
