---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE_NAME } from '../config';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryNames: Record<string, { name: string; color: string }> = {
  cert: { name: '국가자격증', color: '#1d4ed8' },
  hrd: { name: '내일배움카드', color: '#059669' },
  exam: { name: '채용고시', color: '#d97706' },
};
const popularPosts = posts.slice(0, 3);
---

<Layout title={SITE_NAME}>
  <div class="home-wrap">
    <section class="hero">
      <h1>🎓 샛터형의 자격증·국비교육 트렌드센터</h1>
      <p>국가기술자격증 일정부터 내일배움카드 국비지원, 공무원·공기업 채용까지 공식 출처 링크와 함께 정리합니다.</p>
    </section>

    <section class="search-panel" aria-label="블로그 게시물 검색">
      <form id="post-search" role="search">
        <label for="search-query">🔎 Search (검색)</label>
        <div class="search-row">
          <input id="search-query" type="search" placeholder="블로그 글 제목이나 키워드를 입력하세요..." autocomplete="off" />
          <button type="submit">검색</button>
        </div>
        <p class="search-help">이 블로그에 등록된 게시물만 검색합니다.</p>
      </form>
    </section>

    <section class="popular-panel" aria-label="블로그 최신 추천 게시물">
      <h2>🔥 블로그 최신 BEST</h2>
      <p class="popular-note">edublog.setterbro.com에 게시된 글 기준</p>
      <ol>
        {popularPosts.map((post) => (
          <li><a href={`/posts/${post.slug}/`}>{post.data.title}</a><time>{post.data.pubDate.toLocaleDateString('ko-KR')}</time></li>
        ))}
      </ol>
    </section>

    <section class="posts-section">
      <h2>📰 최신 정보 포스팅</h2>
      <p id="search-status" class="search-status" aria-live="polite"></p>
      <div id="post-list">
        {posts.map((post) => {
          const cat = categoryNames[post.data.category] || { name: '일반', color: '#64748b' };
          return (
            <article class="post-card" data-search={`${post.data.title} ${post.data.description} ${cat.name}`.toLowerCase()}>
              <div class="post-meta">
                <span class="category" style={`background:${cat.color}`}>{cat.name}</span>
                <time>{post.data.pubDate.toLocaleDateString('ko-KR')}</time>
              </div>
              <h3><a href={`/posts/${post.slug}/`}>{post.data.title}</a></h3>
              <p class="description">{post.data.description}</p>
              <a class="read-more" href={`/posts/${post.slug}/`}>상세 내용 확인하기 →</a>
            </article>
          );
        })}
      </div>
      <p id="no-results" hidden>검색어와 일치하는 이 블로그의 게시물이 없습니다.</p>
    </section>
  </div>

  <script>
    const form = document.querySelector('#post-search');
    const input = document.querySelector('#search-query');
    const cards = Array.from(document.querySelectorAll('.post-card'));
    const status = document.querySelector('#search-status');
    const empty = document.querySelector('#no-results');

    function filterPosts() {
      const query = input.value.trim().toLocaleLowerCase('ko');
      let count = 0;
      cards.forEach((card) => {
        const matches = !query || card.dataset.search.includes(query);
        card.hidden = !matches;
        if (matches) count += 1;
      });
      empty.hidden = count !== 0;
      status.textContent = query ? `검색 결과 ${count}건` : '';
    }
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      filterPosts();
    });
    input.addEventListener('input', filterPosts);
  </script>

  <style>
    .home-wrap { width: 100%; max-width: 572px; margin: 0 auto; }
    .hero { text-align:center; margin: 0 0 28px; padding: 24px 20px; background:#fff; border:1px solid #e2e8f0; border-radius:12px; }
    .hero h1 { font-size:1.35rem; line-height:1.45; font-weight:800; color:#0f172a; margin-bottom:8px; }
    .hero p { color:#64748b; font-size:.9rem; line-height:1.65; }
    .search-panel,.popular-panel { background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:17px 18px; margin-bottom:18px; box-shadow:0 2px 8px rgba(15,23,42,.025); }
    .search-panel label { display:block; font-size:.95rem; font-weight:800; margin-bottom:10px; color:#1e293b; }
    .search-row { display:flex; gap:8px; }
    .search-row input { min-width:0; flex:1; padding:10px 12px; border:1px solid #cbd5e1; border-radius:8px; background:#f8fafc; color:#1e293b; font:inherit; font-size:.9rem; }
    .search-row button { border:0; border-radius:8px; padding:0 17px; color:white; background:#86198f; font-weight:700; cursor:pointer; }
    .search-help,.popular-note { color:#94a3b8; font-size:.78rem; margin-top:7px; }
    .popular-panel h2,.posts-section h2 { font-size:1.08rem; font-weight:800; color:#1e293b; margin-bottom:10px; }
    .popular-panel ol { list-style:none; }
    .popular-panel li { padding:9px 0; border-top:1px solid #f1f5f9; display:flex; flex-direction:column; gap:3px; }
    .popular-panel li a { color:#334155; text-decoration:none; font-size:.88rem; font-weight:650; line-height:1.5; }
    .popular-panel li a:hover,.post-card h3 a:hover { color:#86198f; }
    .popular-panel time { font-size:.75rem; color:#94a3b8; }
    .posts-section { margin-top:24px; }
    .posts-section h2 { margin-bottom:14px; }
    .post-card { background:#fff; padding:22px 20px; border-radius:12px; border:1px solid #e2e8f0; margin-bottom:16px; box-shadow:0 2px 8px rgba(15,23,42,.025); }
    .post-card[hidden] { display:none; }
    .post-meta { display:flex; gap:10px; align-items:center; margin-bottom:10px; }
    .category { color:#fff; font-size:.72rem; font-weight:700; padding:3px 9px; border-radius:20px; }
    .post-meta time { color:#94a3b8; font-size:.78rem; }
    .post-card h3 { margin-bottom:8px; font-size:1.08rem; line-height:1.5; }
    .post-card h3 a { text-decoration:none; color:#0f172a; font-weight:800; }
    .description { color:#64748b; font-size:.88rem; line-height:1.65; margin-bottom:12px; }
    .read-more { color:#86198f; text-decoration:none; font-weight:700; font-size:.82rem; }
    .search-status { color:#64748b; font-size:.82rem; margin:-6px 0 10px; }
    #no-results { color:#64748b; background:#fff; padding:20px; border:1px solid #e2e8f0; border-radius:10px; text-align:center; }
    @media(max-width:640px) {
      .hero { padding:20px 15px; margin-bottom:18px; }
      .hero h1 { font-size:1.15rem; }
      .hero p { font-size:.82rem; }
      .search-panel,.popular-panel { padding:15px; }
      .post-card { padding:18px 16px; }
    }
  </style>
</Layout>
