---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout title="샛터형 자격증·국비교육 트렌드센터">
  <!-- 상단 메인 안네 타이틀 박스 -->
  <div style="background-color: #ffffff; border: 1px solid #f1f5f9; border-radius: 12px; padding: 20px; text-align: center; margin-bottom: 24px; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.02);">
    <h1 style="font-size: 16px; font-weight: 800; color: #0f172a; margin-bottom: 4px; display: flex; align-items: center; justify-content: center; gap: 6px;">
      <span>🎓</span> 샛터형의 자격증·국비교육 트렌드센터
    </h1>
    <p style="font-size: 11px; color: #64748b;">
      국가기술자격증 일정부터 내일배움카드 국비지원, 공무원·공기업 채용까지 공식 출처 링크와 함께 정리합니다.
    </p>
  </div>

  <h2 style="font-size: 13px; font-weight: 800; color: #0f172a; margin-bottom: 16px; display: flex; align-items: center; gap: 6px;">
    📰 최신 정보 포스팅
  </h2>

  <!-- 원본 나열형 포스팅 리스트 -->
  <div style="display: flex; flex-direction: column; gap: 20px;">
    {sortedPosts.map(post => (
      <article>
        <div style="margin-bottom: 4px;">
          <span style="background-color: #10b981; color: #ffffff; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px; display: inline-block;">
            {post.data.category || 'exam'}
          </span>
        </div>

        <h3 style="font-size: 15px; font-weight: 800; color: #0f172a; margin-bottom: 6px; line-height: 1.35;">
          <a href={`/posts/${post.slug}`} style="color: #0f172a;">{post.data.title}</a>
        </h3>

        <p style="font-size: 12px; color: #64748b; margin-bottom: 8px; line-height: 1.5;">
          {post.data.description}
        </p>

        <a href={`/posts/${post.slug}`} style="font-size: 11px; font-weight: 700; color: #7e22ce; display: inline-flex; align-items: center;">
          상세 내용 확인하기 →
        </a>
      </article>
    ))}
  </div>
</Layout>
