---
import { ADS_ENABLED, ADSENSE_CLIENT } from "../config";
interface Props { slot?: string }
const { slot = "" } = Astro.props;
const show = ADS_ENABLED && /^\d{6,}$/.test(slot);
---
{show && (
  <aside class="ad-wrap" aria-label="광고">
    <span class="ad-label">광고</span>
    <ins class="adsbygoogle" style="display:block;width:100%;" data-ad-client={ADSENSE_CLIENT} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
<style>
  .ad-wrap { margin: 44px 0; padding: 0; text-align: center; clear: both; width: 100%; max-width: 100%; min-height: 250px; overflow: visible; }
  .ad-label { display: block; font-size: 11px; color: #94a3b8; margin-bottom: 6px; letter-spacing: 1px; }
  .ad-wrap:has(ins[data-ad-status="unfilled"]) { display: none; }
</style>
