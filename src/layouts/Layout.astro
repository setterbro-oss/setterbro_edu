---
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = "자격증, 국비지원, 채용고시 정보 센터", image = "/og-default.png" } = Astro.props;

// 사이드바 인기글 데이터를 게시물에서 최신순 3개 가져오기
const allPosts = await getCollection('posts');
const popularPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { 
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; 
        background-color: #f8fafc; 
        color: #334155; 
        line-height: 1.6; 
      }
      a { color: inherit; text-decoration: none; }
      
      /* 헤더 */
      .site-header { background: #ffffff; border-bottom: 1px solid #f1f5f9; position: sticky; top: 0; z-index: 50; }
      .header-inner { max-width: 1080px; margin: 0 auto; padding: 0 16px; height: 56px; display: flex; align-items: center; justify-content: space-between; }
      .brand-logo { font-size: 15px; font-weight: 800; color: #7e22ce; display: flex; align-items: center; gap: 6px; }
      .main-nav { display: flex; gap: 16px; font-size: 13px; font-weight: 700; color: #64748b; }
      .main-nav a:hover { color: #7e22ce; }

      /* 메인 2컬럼 레이아웃 */
      .main-container { 
        max-width: 1080px; 
        margin: 0 auto; 
        padding: 24px 16px; 
        display: flex; 
        flex-direction: column; 
        gap: 24px; 
      }
      
      @media (min-width: 860px) {
        .main-container {
          display: grid;
          grid-template-columns: minmax(0, 1fr) 280px;
          align-items: start;
        }
      }

      /* 우측 사이드바 */
      .sidebar {
        display: flex;
        flex-direction: column;
        gap: 16px;
        width: 100%;
      }

      .sidebar-widget { 
        background: #ffffff; 
        padding: 18px; 
        border-radius: 12px; 
        border: 1px solid #f1f5f9; 
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.02); 
      }
      
      .widget-title { font-size: 14px; font-weight: 800; color: #0f172a; margin-bottom: 12px; display: flex; align-items: center; gap: 4px; }
      
      /* 검색창 */
      .search-box { display: flex; gap: 6px; }
      .search-input { flex: 1; padding: 8px 10px; font-size: 12px; border: 1px solid #e2e8f0; border-radius: 6px; background: #f8fafc; outline: none; }
      .search-input:focus { border-color: #7e22ce; background: #fff; }
      .search-btn { background: #7e22ce; color: #ffffff; padding: 8px 14px; border-radius: 6px; font-size: 12px; font-weight: 700; border: none; cursor: pointer; }

      /* 실시간 인기 BEST 목록 */
      .popular-list { list-style: none; font-size: 13px; margin: 0; padding: 0; }
      .popular-item { padding: 8px 0; border-bottom: 1px solid #f8fafc; }
      .popular-item:last-child { border-bottom: none; padding-bottom: 0; }
      .popular-item a { font-weight: 700; color: #334155; line-height: 1.4; display: block; }
      .popular-item a:hover { color: #7e22ce; }

      footer { padding: 32px 16px; text-align: center; font-size: 12px; color: #7e22ce; margin-top: 32px; }
      footer .footer-links { display: flex; justify-content: center; gap: 12px; margin-bottom: 6px; flex-wrap: wrap; }
      footer .copyright { color: #94a3b8; margin-top: 4px; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand-logo">
          🎓 샛터형 자격증·국비지원 센터
        </a>
        <nav class="main-nav">
          <a href="/">홈</a>
          <a href="/category/cert">국가자격증</a>
          <a href="/category/hrd">내일배움카드</a>
          <a href="/category/exam">채용고시</a>
        </nav>
      </div>
    </header>

    <div class="main-container">
      <!-- 좌측 메인 콘텐츠 영역 -->
      <main>
        <slot />
      </main>

      <!-- 우측 사이드바 영역 -->
      <aside class="sidebar">
        <!-- 1. Search (검색) -->
        <div class="sidebar-widget">
          <h3 class="widget-title">🔍 Search (검색)</h3>
          <form action="/" method="GET" class="search-box">
            <input type="text" name="q" placeholder="검색어를 입력하세요..." required class="search-input" />
            <button type="submit" class="search-btn">검색</button>
          </form>
        </div>

        <!-- 2. 실시간 인기 BEST -->
        <div class="sidebar-widget">
          <h3 class="widget-title">🔥 실시간 인기 BEST</h3>
          <ul class="popular-list">
            {popularPosts.map((post, index) => (
              <li class="popular-item">
                <a href={`/posts/${post.slug}/`}>{index + 1}. {post.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>

    <footer>
      <div class="footer-links">
        <a href="/">홈</a>
        <span>|</span>
        <a href="/about">사이트 소개</a>
        <span>|</span>
        <a href="/privacy">개인정보처리방침</a>
        <span>|</span>
        <a href="/terms">이용약관</a>
      </div>
      <p class="copyright">© 2026 샛터형의 자격증·국비교육 트렌드센터. All rights reserved.</p>
    </footer>
  </body>
</html>
