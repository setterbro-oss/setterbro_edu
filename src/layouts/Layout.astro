---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = "자격증, 국비지원, 채용고시 정보 센터", image = "/og-default.png" } = Astro.props;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script src="https://developers.kakao.com/sdk/js/kakao.min.js" is:inline></script>
    <style is:global>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { 
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; 
        background-color: #f8fafc; 
        color: #334155; 
        line-height: 1.6; 
      }
      a { color: inherit; text-decoration: none; }
      
      /* 헤더 */
      .site-header { background: #ffffff; border-bottom: 1px solid #f1f5f9; position: sticky; top: 0; z-index: 50; }
      .header-inner { max-width: 1000px; margin: 0 auto; padding: 0 16px; height: 56px; display: flex; align-items: center; justify-content: space-between; }
      .brand-logo { font-size: 15px; font-weight: 800; color: #7e22ce; display: flex; align-items: center; gap: 6px; }
      .main-nav { display: flex; gap: 16px; font-size: 12px; font-weight: 700; color: #64748b; }
      .main-nav a:hover { color: #7e22ce; }

      /* 컨테이너 및 2컬럼 레이아웃 */
      .container { max-width: 1000px; margin: 0 auto; padding: 24px 16px; display: grid; grid-template-columns: 1fr; gap: 24px; }
      @media (min-width: 1024px) { .container { grid-template-columns: 2.7fr 1.3fr; } }

      /* 사이드바 전용 흰색 카드 박스 */
      .sidebar-widget { 
        background: #ffffff; 
        padding: 16px; 
        border-radius: 12px; 
        border: 1px solid #f1f5f9; 
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.02); 
        margin-bottom: 16px; 
      }
      
      .widget-title { font-size: 12px; font-weight: 800; color: #0f172a; margin-bottom: 10px; display: flex; align-items: center; gap: 4px; }
      .search-box { display: flex; gap: 6px; }
      .search-input { flex: 1; padding: 6px 10px; font-size: 11px; border: 1px solid #e2e8f0; border-radius: 6px; background: #f8fafc; outline: none; }
      .search-btn { background: #0f172a; color: #ffffff; padding: 6px 12px; border-radius: 6px; font-size: 11px; font-weight: 700; border: none; cursor: pointer; }

      .popular-list { list-style: none; font-size: 11px; }
      .popular-item { padding-bottom: 8px; margin-bottom: 8px; border-bottom: 1px solid #f8fafc; }
      .popular-item:last-child { border-bottom: none; padding-bottom: 0; margin-bottom: 0; }
      .popular-item a { font-weight: 600; color: #334155; line-height: 1.35; display: block; }
      .popular-item a:hover { color: #7e22ce; }

      footer { padding: 32px 16px; text-align: center; font-size: 11px; color: #7e22ce; margin-top: 32px; }
      footer .footer-links { display: flex; justify-content: center; gap: 12px; margin-bottom: 6px; flex-wrap: wrap; }
      footer .copyright { color: #94a3b8; margin-top: 4px; }

      /* 본문 마크다운 표 스타일 */
      table { width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 12px; }
      th, td { border: 1px solid #e2e8f0; padding: 8px 10px; text-align: left; }
      th { background-color: #f8fafc; font-weight: 700; color: #0f172a; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand-logo">
          🎓 샛터형 자격증·국비지원 센터
        </a>
        <nav class="main-nav">
          <a href="/">홈</a>
          <a href="/category/national">국가지원중</a>
          <a href="/category/card">내일배움카드</a>
          <a href="/category/exam">채용고시</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <section>
        <slot />
      </section>

      <aside>
        <div class="sidebar-widget">
          <h3 class="widget-title">🔍 Search (검색)</h3>
          <form action="/search" method="GET" class="search-box">
            <input type="text" name="q" placeholder="검색어를 입력하세요..." required class="search-input" />
            <button type="submit" class="search-btn">검색</button>
          </form>
        </div>

        <div class="sidebar-widget">
          <h3 class="widget-title">🔥 실시간 인기 BEST</h3>
          <ul class="popular-list">
            <li class="popular-item">
              <a href="#">1. 모르면 매달 손해보는 은행 종수신 폭증 속 이자 극대화 로드맵</a>
            </li>
            <li class="popular-item">
              <a href="#">2. 모르면 잃는 신혼부부 세액공제, 13월의 월급을 즉시 확인하세요</a>
            </li>
            <li class="popular-item">
              <a href="#">3. 연말정산 놓쳤다면? 5월 종합소득세 신고·경정청구로 환급받는 법</a>
            </li>
          </ul>
        </div>
      </aside>
    </main>

    <footer>
      <div class="footer-links">
        <a href="/about">문의하기</a>
        <span>|</span>
        <a href="/terms">이용약관 및 면책공고</a>
        <span>|</span>
        <a href="/privacy">개인정보처리방침</a>
        <span>|</span>
        <a href="/about">사이트 소개</a>
      </div>
      <p class="copyright">© 2026 샛터형의 자격증·국비교육 트렌드센터. All rights reserved.</p>
    </footer>
  </body>
</html>
