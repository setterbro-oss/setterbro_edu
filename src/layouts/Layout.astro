---
import { SITE_NAME, SHORT_NAME, DEFAULT_DESC, OG_IMAGE_PATH, ADS_ENABLED, ADSENSE_CLIENT } from '../config';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  pubDate?: Date;
  jsonLd?: object[];
}

const { title, description = DEFAULT_DESC, noindex = false, type = 'website', pubDate, jsonLd = [] } = Astro.props;

// 검색엔진 소유권 확인 코드
const GOOGLE_VERIFICATION = 'svZc3E2kbjwkhqvWbCK9MNkMA7PfceqJnusg7GIV_1Y';
const NAVER_VERIFICATION = '05bc3d50faac5511ddefdc43ceeebe2f5b7cf19a';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(OG_IMAGE_PATH, Astro.site).href;
const fullTitle = title === SITE_NAME ? SITE_NAME : `${title} | ${SHORT_NAME}`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <meta name="theme-color" content="#1d4ed8" />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {GOOGLE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_VERIFICATION} />}
    {NAVER_VERIFICATION && <meta name="naver-site-verification" content={NAVER_VERIFICATION} />}
    <meta name="google-adsense-account" content={ADSENSE_CLIENT} />
    {ADS_ENABLED && (
      <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <style is:global>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { -webkit-text-size-adjust: 100%; }
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans KR", "Malgun Gothic", sans-serif; line-height: 1.7; color: #1e293b; background: #f8fafc; }
      img, iframe, video, svg { max-width: 100%; height: auto; }
      pre { overflow-x: auto; max-width: 100%; }
      header { background: #ffffff; border-bottom: 1px solid #e2e8f0; padding: 14px 16px; position: sticky; top: 0; z-index: 50; }
      .nav-container { max-width: 900px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 6px 16px; }
      .site-title { font-size: 1.2rem; font-weight: 800; color: #1d4ed8; text-decoration: none; }
      .nav-links { display: flex; flex-wrap: wrap; gap: 2px 16px; }
      .nav-links a { color: #475569; text-decoration: none; font-size: 0.95rem; font-weight: 600; }
      .nav-links a:hover { color: #1d4ed8; }
      main { max-width: 900px; margin: 30px auto; padding: 0 16px; min-height: 70vh; }
      footer { background: #ffffff; border-top: 1px solid #e2e8f0; padding: 30px 16px; text-align: center; color: #64748b; font-size: 0.85rem; margin-top: 60px; }
      footer a { color: #64748b; text-decoration: none; margin: 0 8px; }
      footer a:hover { text-decoration: underline; }
      @media (max-width: 640px) {
        header { position: static; padding: 12px 12px; }
        .site-title { font-size: 1.05rem; }
        .nav-links a { font-size: 0.9rem; }
        main { margin: 16px auto; padding: 0 10px; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="nav-container">
        <a href="/" class="site-title">🎓 샛터형 자격증·국비지원 센터</a>
        <nav class="nav-links">
          <a href="/">홈</a>
          <a href="/category/cert/">국가자격증</a>
          <a href="/category/hrd/">내일배움카드</a>
          <a href="/category/exam/">채용고시</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p style="margin-bottom: 10px;">
        <a href="/">홈</a> |
        <a href="/about/">사이트 소개</a> |
        <a href="/privacy/">개인정보처리방침</a> |
        <a href="/terms/">이용약관</a>
      </p>
      <p>&copy; 2026 샛터형의 자격증·국비교육 트렌드센터. All rights reserved.</p>
    </footer>
  </body>
</html>
