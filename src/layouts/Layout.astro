---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "2026 국가기술자격증·국비지원 내일배움카드·공무원 공기업 채용 실시간 정보 포털" } = Astro.props;

// 검색엔진 소유권 확인 코드 (서치콘솔/서치어드바이저에서 받은 값을 따옴표 안에 붙여넣기, 비워두면 출력 안 됨)
const GOOGLE_VERIFICATION = '';
const NAVER_VERIFICATION = '';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = `${title} | 샛터형의 자격증·국비교육 트렌드센터`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="샛터형의 자격증·국비교육 트렌드센터" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    {GOOGLE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_VERIFICATION} />}
    {NAVER_VERIFICATION && <meta name="naver-site-verification" content={NAVER_VERIFICATION} />}
    <!-- 구글 애드센스 소유권 메타태그 (승인용) -->
    <meta name="google-adsense-account" content="ca-pub-7506668912689327" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans KR", sans-serif; line-height: 1.7; color: #1e293b; background: #f8fafc; }
      header { background: #ffffff; border-bottom: 1px solid #e2e8f0; padding: 18px 20px; position: sticky; top: 0; z-index: 50; }
      .nav-container { max-width: 900px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
      .site-title { font-size: 1.25rem; font-weight: 800; color: #1d4ed8; text-decoration: none; }
      .nav-links a { margin-left: 15px; color: #475569; text-decoration: none; font-size: 0.95rem; font-weight: 600; }
      .nav-links a:hover { color: #1d4ed8; }
      main { max-width: 900px; margin: 30px auto; padding: 0 16px; min-height: 70vh; }
      footer { background: #ffffff; border-top: 1px solid #e2e8f0; padding: 30px 16px; text-align: center; color: #64748b; font-size: 0.85rem; margin-top: 60px; }
      footer a { color: #64748b; text-decoration: none; margin: 0 8px; }
      footer a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <header>
      <div class="nav-container">
        <a href="/" class="site-title">🎓 샛터형 자격증·국비지원 센터</a>
        <nav class="nav-links">
          <a href="/">홈</a>
          <a href="/category/cert">국가자격증</a>
          <a href="/category/hrd">내일배움카드</a>
          <a href="/category/exam">채용고시</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p style="margin-bottom: 10px;">
        <a href="/">홈</a> |
        <a href="/about">사이트 소개</a> |
        <a href="/privacy">개인정보처리방침</a> |
        <a href="/terms">이용약관</a>
      </p>
      <p>&copy; 2026 샛터형의 자격증·국비교육 트렌드센터. All rights reserved.</p>
    </footer>
  </body>
</html>
